# Выберите ОДИН провайдер (раскомментируйте нужный блок).

# Вариант 1: Anthropic Claude
#LLM_PROVIDER=anthropic
#ANTHROPIC_API_KEY=sk-ant-...
#DEFAULT_MODEL=claude-sonnet-4-6

# Вариант 2: OpenAI (ChatGPT)
#LLM_PROVIDER=openai
#OPENAI_API_KEY=sk-...
#DEFAULT_MODEL=gpt-4o

# Вариант 3: Ollama (локально, бесплатно)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=qwen2.5:7b

# Вариант 4: GateLLM (OpenAI-совместимый, работает в России)
#LLM_PROVIDER=gatellm
#GATELLM_API_KEY=sk-...
#DEFAULT_MODEL=qwen/qwen-2.5-72b-instruct

# Параметры агента
MAX_STEPS=10
REQUEST_TIMEOUT=30